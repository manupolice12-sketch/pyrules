{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "name": "RuleScript",
    "scopeName": "source.rules",
    "fileTypes": [".rules"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.number-sign.rules",
            "match": "#.*$"
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.rules",
                    "match": "\\b(rule|when|then)\\b"
                },
                {
                    "name": "keyword.other.rules",
                    "match": "\\b(use|and|or)\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.rules",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.rules",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.rules",
            "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        "operators": {
            "name": "keyword.operator.rules",
            "match": "==|!=|<=|>=|<|>|=|\\+|-|\\*|/"
        }
    }
}
